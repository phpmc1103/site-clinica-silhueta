---
import { Image } from "astro:assets";
import { clinica } from "../dados/clinica";
import logoHorizontalClaro from "../assets/logo/logo-horizontal-claro.svg";

const ano = new Date().getFullYear();
---

<footer class="footer fundo-verde" id="contato">
  <div class="container colunas">
    <div>
      <Image class="logo" src={logoHorizontalClaro} alt="Clínica Silhueta" />
      <p class="suave">Clínica médica em Cuiabá. Há mais de 30 anos cuidando da sua saúde e do seu bem-estar.</p>
      <!-- TODO: nome, CRM e RQE do responsável técnico -->
      <p class="suave pequeno">Responsável técnico: Dr(a). Nome Sobrenome · CRM-MT 0000</p>
    </div>

    <div>
      <h2>Onde estamos</h2>
      <address>
        {clinica.endereco}<br />
        {clinica.cidade}
      </address>
      <a href={clinica.mapaLink} target="_blank" rel="noopener">Ver no mapa</a>
    </div>

    <div>
      <h2>Horários</h2>
      <ul>
        {clinica.horarios.map((h) => <li>{h}</li>)}
      </ul>
    </div>

    <div>
      <h2>Fale com a gente</h2>
      <ul>
        <li>WhatsApp: <a href={clinica.whatsappLink} target="_blank" rel="noopener">{clinica.whatsappTexto}</a></li>
        <li>Telefone: <a href={clinica.telefoneLink}>{clinica.telefoneTexto}</a></li>
        <li>Instagram: <a href={clinica.instagramLink} target="_blank" rel="noopener">{clinica.instagram}</a></li>
      </ul>
    </div>
  </div>

  <!-- Mapa: o iframe só carrega quando o visitante rola até aqui (loading="lazy") -->
  <div class="container mapa">
    <iframe
      title="Mapa com a localização da Clínica Silhueta"
      src="https://www.google.com/maps?q=Rua+24+de+Outubro+194+Centro+Norte+Cuiaba+MT&output=embed"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>

  <div class="container rodape-final">
    <p>© {ano} Clínica Silhueta · Cuiabá, MT</p>
    <a href="/privacidade">Política de privacidade</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--verde-900);
    color: var(--creme-50);
    padding-top: 4rem;
    font-size: 0.95rem;
  }

  .colunas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.5rem;
  }

  .logo {
    height: 3.5rem;
    width: auto;
    margin-bottom: 1.25rem;
  }

  h2 {
    font-family: var(--fonte-texto);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--verde-200);
    margin-bottom: 1rem; /* título e conteúdo separados só pelo espaço */
  }

  address {
    font-style: normal;
    margin-bottom: 0.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  a {
    color: var(--verde-200);
  }

  a:hover {
    color: var(--creme-50);
  }

  .suave {
    color: var(--verde-200);
  }

  .pequeno {
    font-size: 0.85rem;
  }

  .mapa {
    margin-top: 3rem;
    height: 18rem;
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .rodape-final {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-block: 1.5rem;
    font-size: 0.85rem;
    color: var(--verde-200);
  }

  .rodape-final p {
    margin: 0;
  }
</style>
