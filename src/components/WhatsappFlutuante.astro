---
import IconeWhatsapp from "./IconeWhatsapp.astro";
import { clinica } from "../dados/clinica";
---

<a
  class="flutuante"
  href={clinica.whatsappLink}
  target="_blank"
  rel="noopener"
  aria-label="Agendar pelo WhatsApp"
>
  <IconeWhatsapp tamanho={30} />
</a>

<style>
  .flutuante {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--whatsapp); /* verde do próprio WhatsApp, para ser reconhecido na hora */
    color: var(--branco);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--marrom-900) 25%, transparent);
    transition: transform 0.2s, background 0.2s;
  }

  .flutuante:hover {
    background: var(--whatsapp-hover);
    color: var(--branco);
    transform: scale(1.06);
  }
</style>
