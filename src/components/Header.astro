---
import { Image } from "astro:assets";
import logoHorizontalClaro from "../assets/logo/logo-horizontal-claro.svg";

const links = [
  { href: "/", texto: "Início" },
  { href: "/tratamentos", texto: "Tratamentos" },
  { href: "/programas", texto: "Programas" },
  { href: "/noticias", texto: "Notícias" },
  { href: "/contato", texto: "Contato" },
];

// Marca o link da página atual (aria-current) para leitor de tela e estilo
const atual = Astro.url.pathname;
const ativo = (href: string) =>
  href === "/" ? atual === "/" : atual.startsWith(href);
---

<!-- Marcador invisível no topo da página: quando sai da tela, o header fica compacto -->
<div class="sentinela" aria-hidden="true"></div>

<header class="header fundo-verde">
  <div class="container barra">
    <a href="/" class="logo">
      <Image src={logoHorizontalClaro} alt="Clínica Silhueta" loading="eager" />
    </a>

    <nav aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={ativo(link.href) ? "page" : undefined}>
              {link.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Liga o modo compacto quando o marcador do topo sai da tela, e desliga quando volta.
  // IntersectionObserver avisa só nessas mudanças, sem rodar código a cada rolagem.
  const header = document.querySelector(".header");
  const sentinela = document.querySelector(".sentinela");

  if (header && sentinela) {
    new IntersectionObserver(([entrada]) => {
      header.toggleAttribute("data-compacto", !entrada.isIntersecting);
    }).observe(sentinela);
  }
</script>

<style>
  /* Altura de rolagem a partir da qual o header encolhe */
  .sentinela {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 6rem;
    pointer-events: none;
  }

  /* Fica preso no topo da tela enquanto a página rola */
  .header {
    position: sticky;
    top: 0;
    z-index: 40; /* acima do conteúdo, abaixo do botão de WhatsApp (50) */
    background: var(--verde-700); /* o mesmo verde do rodapé */
    border-bottom: 1px solid var(--verde-900);
    transition: box-shadow 0.3s;
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    transition: padding 0.3s;
  }

  .logo {
    display: block;
  }

  /* A largura acompanha a altura, mantendo a proporção do SVG */
  .logo img {
    height: 4.25rem;
    width: auto;
    transition: height 0.3s;
  }

  /* Menu: só texto; a página atual ganha um sublinhado dourado */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: 0.5rem; /* área de toque maior no celular */
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--creme-50);
    text-decoration: underline 2px transparent;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s;
  }

  nav a:hover {
    color: var(--creme-50);
    text-decoration-color: var(--verde-200);
  }

  nav a[aria-current="page"] {
    text-decoration-color: var(--dourado-400);
  }

  /* Header compacto: aparece depois que a página rola */
  .header[data-compacto] {
    box-shadow: 0 4px 16px color-mix(in srgb, var(--verde-900) 30%, transparent);
  }

  .header[data-compacto] .barra {
    padding-block: 0.6rem;
  }

  .header[data-compacto] .logo img {
    height: 3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .barra,
    .logo img,
    nav a {
      transition: none;
    }
  }

  /* No celular o menu vai para a linha de baixo, ocupando a largura toda */
  @media (max-width: 760px) {
    nav {
      order: 3;
      width: 100%;
    }
    ul {
      justify-content: space-between;
      gap: 0.25rem 1rem;
    }
    .barra {
      padding-block: 1rem 0.25rem;
    }
    .logo img {
      height: 3rem;
    }
    .header[data-compacto] .logo img {
      height: 2.5rem;
    }
  }

  /* Celular: os 5 itens numa linha só. Fonte e espaço diminuem com a largura
     da tela (clamp). Se mesmo assim não couber (telas muito estreitas), o menu
     rola de lado, sem barra visível; a página nunca rola */
  @media (max-width: 640px) {
    ul {
      flex-wrap: nowrap;
      gap: clamp(0.4rem, 3vw, 1rem);
      overflow-x: auto;
      scrollbar-width: none; /* Firefox */
    }
    ul::-webkit-scrollbar {
      display: none; /* Chrome e Safari */
    }
    li {
      flex: none;
    }
    nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px; /* área de toque mínima recomendada */
      padding-block: 0;
      font-size: clamp(0.75rem, 3.7vw, 1rem);
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
  }
</style>
