---
const links = [
  { href: "/", texto: "Início" },
  { href: "/tratamentos", texto: "Tratamentos" },
  { href: "/noticias", texto: "Notícias" },
  { href: "/contato", texto: "Contato" },
];

// Marca o link da página atual (aria-current) para leitor de tela e estilo
const atual = Astro.url.pathname;
const ativo = (href: string) =>
  href === "/" ? atual === "/" : atual.startsWith(href);
---

<header class="header">
  <div class="container barra">
    <a href="/" class="logo">
      <!-- TODO: trocar pelo símbolo da clínica (<Image> de astro:assets) quando o cliente mandar -->
      <span class="logo-simbolo" aria-hidden="true"></span>
      <span class="logo-texto">
        <span class="logo-nome">Silhueta</span>
        <span class="logo-sub">Clínica Médica</span>
      </span>
    </a>

    <nav aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={ativo(link.href) ? "page" : undefined}>
              {link.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--cor-fundo);
    border-bottom: 1px solid var(--cor-nude);
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--cor-texto);
  }

  /* Espaço reservado para o símbolo da clínica */
  .logo-simbolo {
    width: 3rem;
    height: 3rem;
    border: 1px dashed var(--cor-dourado);
    border-radius: 50%;
    background: var(--cor-areia);
  }

  .logo-texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .logo-nome {
    font-family: var(--fonte-titulo);
    font-size: 1.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .logo-sub {
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--cor-dourado-escuro);
    margin-top: 0.3rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--cor-texto);
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--cor-nude);
    border-radius: 999px;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    border-color: var(--cor-dourado);
    background: var(--cor-areia);
  }

  /* No celular o menu vai para a linha de baixo, ocupando a largura toda */
  @media (max-width: 760px) {
    nav {
      order: 3;
      width: 100%;
    }
    ul {
      justify-content: space-between;
    }
  }
</style>
