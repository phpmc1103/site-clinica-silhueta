---
// Prévia estática do perfil do Instagram: foto, @, uma linha de texto, botão e 4 posts.
// Sem feed automático nem script da Meta: só links para o perfil.
// Imagens em src/assets/instagram/ (perfil.jpg e post-1.jpg a post-4.jpg). Arquivo que
// não existir vira um quadrado na cor da paleta, sem quebrar a build.
// Qualquer post pode ser um vídeo: public/instagram/post-N.mp4 (com o poster
// post-N-poster.jpg). Sem o arquivo, ele volta a ser imagem ou placeholder.
// Uso (dentro de um .container): <CardInstagram />
import { existsSync } from "node:fs";
import { Image } from "astro:assets";
import { clinica } from "../dados/clinica";
import IconeInstagram from "./IconeInstagram.astro";

// O glob só encontra os arquivos que existem (com uma pasta vazia, volta {}).
// Um import normal de arquivo inexistente quebraria a build.
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/instagram/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const imagem = (nome: string) =>
  Object.entries(arquivos).find(([caminho]) =>
    caminho.split("/").pop()!.startsWith(`${nome}.`),
  )?.[1].default;

const perfil = imagem("perfil");

// Vídeos dos posts. Ficam em public/ (o astro:assets não otimiza vídeo), e a
// existência é conferida na build, a partir da raiz do projeto
const publico = (arquivo: string) =>
  existsSync(`public/instagram/${arquivo}`) ? `/instagram/${arquivo}` : undefined;

// TODO: descrever cada post quando as fotos chegarem
const posts = [1, 2, 3, 4].map((n) => ({
  video: publico(`post-${n}.mp4`),
  poster: publico(`post-${n}-poster.jpg`),
  imagem: imagem(`post-${n}`),
  alt: `Post ${n} da Clínica Silhueta no Instagram`,
}));
---

<div class="card-instagram">
  <div class="perfil">
    {perfil ? (
      <Image
        class="avatar"
        src={perfil}
        alt=""
        width={128}
        height={128}
        loading="lazy"
      />
    ) : (
      <span class="avatar avatar-vazio" aria-hidden="true">
        <!-- Glifo oficial do Instagram (traçado do Simple Icons, CC0), branco sobre o
             círculo com o gradiente da marca. Proporção 1:1 preservada: não esticar nem redesenhar -->
        <svg class="glifo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"
          ></path>
        </svg>
      </span>
    )}
    <div>
      <p class="arroba">{clinica.instagram}</p>
      <p class="linha">Novidades, bastidores e dicas de cuidado.</p>
    </div>
    <a
      class="botao botao-contorno seguir"
      href={clinica.instagramLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Seguir a Clínica Silhueta no Instagram (abre em nova aba)"
    >
      <!-- Ícone monocromático (currentColor): acompanha a cor do botão -->
      <IconeInstagram tamanho={18} /> Seguir no Instagram
    </a>
  </div>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a
          href={clinica.instagramLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${post.alt} (abre em nova aba)`}
        >
          {post.video ? (
            <>
              <!-- Sem autoplay no HTML: o script abaixo dá play só com o quadrado
                   na tela. Sem JavaScript, fica o poster -->
              <video
                class="post-video"
                src={post.video}
                poster={post.poster}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
              <svg class="icone-reel" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
                <path d="M3.5 8.5h17M9 3.5l3 5M14.5 3.5l3 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
                <path d="M10 11.5v5.5l4.75-2.75z" fill="currentColor"></path>
              </svg>
            </>
          ) : post.imagem ? (
            <Image
              src={post.imagem}
              alt={post.alt}
              widths={[200, 400]}
              sizes="(min-width: 1024px) 12rem, 45vw"
              loading="lazy"
            />
          ) : (
            <span class="post-vazio" aria-hidden="true"></span>
          )}
          <span class="sobreposicao" aria-hidden="true"><IconeInstagram tamanho={28} /></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  // Vídeo dos posts: toca só enquanto aparece na tela e pausa quando sai.
  // Com "reduzir movimento" ligado no sistema, não toca: fica só o poster.
  const reduzirMovimento = matchMedia("(prefers-reduced-motion: reduce)");

  for (const video of document.querySelectorAll<HTMLVideoElement>(".post-video")) {
    new IntersectionObserver(
      ([entrada]) => {
        if (entrada.isIntersecting && !reduzirMovimento.matches) {
          video.play().catch(() => {}); // o navegador pode recusar; fica o poster
        } else {
          video.pause();
        }
      },
      { threshold: 0.25 },
    ).observe(video);
  }
</script>

<style>
  /* Um pouco mais estreito que o container, centralizado */
  .card-instagram {
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--areia-100);
  }

  /* Perfil: avatar e texto lado a lado, botão embaixo */
  .perfil {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  /* Sem foto de perfil: círculo com o gradiente oficial do Instagram (amarelo e
     laranja embaixo à esquerda, rosa e roxo em cima à direita) e o glifo branco */
  .avatar-vazio {
    display: grid;
    place-items: center;
    background: radial-gradient(
      circle at 30% 107%,
      var(--instagram-amarelo) 0%,
      var(--instagram-amarelo) 5%,
      var(--instagram-laranja) 45%,
      var(--instagram-rosa) 60%,
      var(--instagram-azul) 90%
    );
    color: var(--branco);
  }

  /* Tamanho fixo e igual nos dois lados: o glifo não distorce */
  .glifo {
    width: 1.75rem;
    height: 1.75rem;
  }

  .arroba {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--verde-700);
  }

  .linha {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--marrom-700);
  }

  .seguir {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 0.6rem 1.25rem;
    font-size: 0.95rem;
  }

  /* Posts: 2×2 no celular, 4 lado a lado no computador */
  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts a {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: var(--raio-foto);
    overflow: hidden;
  }

  /* O overflow: hidden cortaria o contorno de foco: ele vai para dentro */
  .posts a:focus-visible {
    outline-offset: -3px;
  }

  .posts :global(img),
  .post-video,
  .post-vazio {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* O vídeo também fica creme enquanto o poster não carrega */
  .post-vazio,
  .post-video {
    background: var(--creme-50);
  }

  /* Ícone de reel no canto, como no Instagram. A sombra separa o branco de fotos claras */
  .icone-reel {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--branco);
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--verde-900) 60%, transparent));
  }

  /* Ao passar o mouse (ou focar pelo teclado): escurece de leve e mostra o ícone */
  .sobreposicao {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--verde-900) 35%, transparent);
    color: var(--creme-50);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .posts a:hover .sobreposicao,
  .posts a:focus-visible .sobreposicao {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .card-instagram {
      grid-template-columns: 17rem 1fr;
      gap: 2rem;
      padding: 1.5rem 1.5rem 1.5rem 2rem;
    }
    .posts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sobreposicao {
      transition: none;
    }
  }
</style>
