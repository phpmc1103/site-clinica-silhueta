---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import IconeWhatsapp from "../../components/IconeWhatsapp.astro";
import { clinica } from "../../dados/clinica";
import { categorias } from "../../dados/categorias";

// Gera uma página para cada categoria: /tratamentos/facial, /corporal e /injetaveis
export function getStaticPaths() {
  return categorias.map((categoria) => ({
    params: { categoria: categoria.id },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;

const tratamentos = (await getCollection("tratamentos"))
  .filter((t) => t.data.categoria === categoria.id)
  .sort((a, b) => a.data.ordem - b.data.ordem);
---

<BaseLayout
  titulo={`Tratamentos: ${categoria.titulo}`}
  descricao={`${categoria.descricao} Clínica Silhueta, em Cuiabá.`}
>
  <section class="topo">
    <div class="container">
      <a class="voltar" href="/tratamentos"><span aria-hidden="true">←</span> Todos os tratamentos</a>
      <div class="titulo-secao">
        <p class="sobretitulo">Tratamentos</p>
        <h1>{categoria.titulo}</h1>
        <p>{categoria.descricao}</p>
      </div>
    </div>
  </section>

  <section class="secao lista">
    <div class="container">
      <ul class="cards">
        {tratamentos.map((t) => (
          <li class="card">
            <h2>{t.data.titulo}</h2>
            <p>{t.data.resumo}</p>
            <a href={`/tratamentos/${t.id}`}>
              Saiba mais <span class="visualmente-oculto">sobre {t.data.titulo}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="container titulo-secao final">
      <h2>Não sabe qual escolher?</h2>
      <p>Fale com a gente. Na consulta de avaliação, o médico indica o caminho certo para você.</p>
      <a class="botao" href={clinica.whatsappLink} target="_blank" rel="noopener">
        <IconeWhatsapp /> Agendar pelo WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .topo {
    padding-block: clamp(2rem, 5vw, 3rem) 0;
  }

  .topo .titulo-secao {
    margin-bottom: 0;
  }

  .voltar {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .voltar:hover {
    text-decoration: underline;
  }

  .lista {
    padding-top: 3rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Card com o topo em arco, como no Menu de Cuidados */
  .card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem 1.5rem 1.75rem;
    background: var(--branco);
    border: 1px solid var(--creme-200);
    border-radius: 8rem 8rem 0 0;
    text-align: center;
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--verde-700);
  }

  .card h2 {
    font-size: 1.4rem;
    transition: color 0.2s;
  }

  .card:hover h2 {
    color: var(--verde-700);
  }

  .card p {
    color: var(--marrom-700);
    font-size: 0.95rem;
    flex: 1;
  }

  .card a {
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .card a:hover {
    text-decoration: underline;
  }

  .final {
    margin-bottom: 0;
  }

  /* Texto só para leitor de tela: diferencia os vários "Saiba mais" */
  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
