---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import IconeWhatsapp from "../components/IconeWhatsapp.astro";
import { clinica } from "../dados/clinica";
import fotoRecepcao from "../assets/fotos/recepcao.jpg";

// Seção 2: serviços organizados pelo que o paciente procura
const cuidados = [
  {
    problema: "Linhas de expressão e rugas",
    tratamentos: "Toxina botulínica, preenchimento e fios de sustentação",
  },
  {
    problema: "Flacidez e perda de firmeza",
    tratamentos: "Ultraformer, Sculptra e Elleva",
  },
  {
    problema: "Manchas, textura e viço da pele",
    tratamentos: "Laser Lavieen, peeling, microagulhamento e limpeza de pele",
  },
  {
    problema: "Gordura localizada e contorno corporal",
    tratamentos: "Heccus Turbo, lipo enzimática, carboxiterapia e massagem modeladora",
  },
  {
    problema: "Peso e composição corporal",
    tratamentos: "Protocolos de emagrecimento e de sarcopenia, com acompanhamento médico",
  },
  {
    problema: "Cansaço, stress e bem-estar",
    tratamentos: "Protocolo stress e ansiedade, reposição de vitaminas e massagem relaxante",
  },
];

// Seção 4: passos até o tratamento
const passos = [
  { titulo: "Fale com a gente", texto: "Chame no WhatsApp e escolha o melhor dia e horário." },
  { titulo: "Consulta de avaliação", texto: "O médico conversa com você e avalia o que faz sentido para o seu caso." },
  { titulo: "Plano de cuidado", texto: "Você recebe um plano com as etapas, os cuidados e as orientações." },
  { titulo: "Acompanhamento", texto: "Retornos para acompanhar a evolução e ajustar o que for preciso." },
];

// Seção 5: ambientes (TODO: fotos reais)
const ambientes = ["Recepção", "Consultório", "Sala de procedimentos", "Sala de espera"];
---

<BaseLayout titulo="Início">
  <!-- 1. Topo -->
  <section class="hero">
    <div class="container hero-grade">
      <div class="hero-texto">
        <p class="sobretitulo">Clínica médica em Cuiabá</p>
        <h1>Cuidado médico para a sua saúde, beleza e bem-estar</h1>
        <p class="hero-sub">
          Há mais de 30 anos a Clínica Silhueta acolhe cada paciente com atenção, avaliação
          individual e tratamentos conduzidos por profissionais qualificados.
        </p>
        <div class="acoes">
          <a class="botao" href={clinica.whatsappLink} target="_blank" rel="noopener">
            <IconeWhatsapp /> Agendar pelo WhatsApp
          </a>
          <a class="botao botao-contorno" href="/tratamentos">Ver tratamentos</a>
        </div>
      </div>

      <!-- Foto decorativa (alt vazio). É a primeira imagem da página: carrega com prioridade.
           O quadro em volta recebe a máscara, para a foto e a camada creme sumirem juntas nas bordas. -->
      <div class="hero-foto">
        <Image
          src={fotoRecepcao}
          alt=""
          widths={[400, 640, 960]}
          sizes="(min-width: 761px) 40vw, 20rem"
          loading="eager"
          fetchpriority="high"
          quality={80}
        />
      </div>
    </div>
  </section>

  <!-- 2. Cuidados por problema -->
  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <p class="sobretitulo">Tratamentos</p>
        <h2>O que você procura?</h2>
        <p>Escolha o que mais combina com você. Na consulta, o médico indica o caminho certo para o seu caso.</p>
      </div>
      <ul class="cards">
        {cuidados.map((c) => (
          <li class="card">
            <h3>{c.problema}</h3>
            <p>{c.tratamentos}</p>
            <a href="/tratamentos">Saiba mais <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Quem cuida de você -->
  <section class="secao secao-areia">
    <div class="container medico">
      <div class="medico-foto foto-provisoria">Foto do médico (TODO)</div>
      <div>
        <p class="sobretitulo">Quem cuida de você</p>
        <!-- TODO: nome, especialidade, CRM e RQE do responsável técnico -->
        <h2>Dr(a). Nome Sobrenome</h2>
        <p class="registro">Especialidade · CRM-MT 0000 · RQE 0000</p>
        <p>
          Breve apresentação do médico responsável: formação, áreas de atuação e a forma de
          cuidar dos pacientes. Texto a ser escrito com o próprio médico.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Como funciona -->
  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <p class="sobretitulo">Como funciona</p>
        <h2>Do primeiro contato ao tratamento</h2>
      </div>
      <ol class="passos">
        {passos.map((p, i) => (
          <li>
            <span class="numero" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
      <div class="centro">
        <a class="botao" href={clinica.whatsappLink} target="_blank" rel="noopener">
          <IconeWhatsapp /> Agendar pelo WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- 5. A clínica -->
  <section class="secao secao-areia">
    <div class="container">
      <div class="titulo-secao">
        <p class="sobretitulo">A clínica</p>
        <h2>Um espaço pensado para você</h2>
        <p>{clinica.endereco}, no Centro Norte de Cuiabá.</p>
      </div>
      <ul class="galeria">
        {ambientes.map((nome) => (
          <li class="foto-provisoria">{nome} (TODO)</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. Topo */
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    background: var(--creme-50); /* cor única: a foto some sempre na mesma cor */
  }

  .hero-grade {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--marrom-700);
    max-width: 32rem;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Quadro da foto: some suavemente nos 4 lados, como se a foto não acabasse.
     Mais longo à esquerda (35%) e embaixo (30%), mais curto em cima e à direita (12%).
     Os dois degradês são combinados com "intersect": só aparece onde os dois deixam. */
  .hero-foto {
    position: relative;
    --mascara-horizontal: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.3) 12%,
      rgb(0 0 0 / 0.7) 24%,
      #000 35%,
      #000 88%,
      rgb(0 0 0 / 0.7) 92%,
      rgb(0 0 0 / 0.3) 96%,
      transparent 100%
    );
    --mascara-vertical: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(0 0 0 / 0.3) 4%,
      rgb(0 0 0 / 0.7) 8%,
      #000 12%,
      #000 70%,
      rgb(0 0 0 / 0.7) 80%,
      rgb(0 0 0 / 0.3) 90%,
      transparent 100%
    );
    -webkit-mask-image: var(--mascara-horizontal), var(--mascara-vertical);
    -webkit-mask-composite: source-in;
    mask-image: var(--mascara-horizontal), var(--mascara-vertical);
    mask-composite: intersect;
  }

  .hero-foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Camada creme leve por cima, puxando a foto para os tons do fundo */
  .hero-foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--creme-100);
    opacity: 0.25;
  }

  /* 2. Cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    background: var(--branco);
    border: 1px solid var(--creme-200);
    text-align: center;
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--verde-700);
  }

  .card h3 {
    transition: color 0.2s;
  }

  .card:hover h3 {
    color: var(--verde-700);
  }

  .card p {
    color: var(--marrom-700);
    font-size: 0.98rem;
    flex: 1;
  }

  .card a {
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  /* 3. Médico */
  .medico {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .medico-foto {
    aspect-ratio: 3 / 4;
    max-width: 22rem;
  }

  .registro {
    color: var(--verde-700);
    letter-spacing: 0.05em;
  }

  /* 4. Passos */
  .passos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  .passos li {
    border-top: 1px solid var(--dourado-400);
    padding-top: 1.25rem;
  }

  .numero {
    font-family: var(--fonte-titulo);
    font-size: 2.5rem;
    color: var(--dourado-400);
    line-height: 1;
  }

  .passos p {
    color: var(--marrom-700);
  }

  .centro {
    text-align: center;
  }

  /* 5. Galeria */
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .galeria li {
    aspect-ratio: 3 / 4;
  }

  /* Celular: colunas viram uma só */
  @media (max-width: 760px) {
    .hero-grade,
    .medico {
      grid-template-columns: 1fr;
    }
    .hero-foto {
      max-width: 20rem;
      margin-inline: auto;
    }
    .medico-foto {
      margin-inline: auto;
    }
  }
</style>
